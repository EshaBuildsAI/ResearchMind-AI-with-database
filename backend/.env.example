# Copy this file to .env and fill in real values. Never commit .env itself.

ENV=development

# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./researchmind.db
# Production (Postgres) example:
# DATABASE_URL=postgresql://researchmind_user:PASSWORD@localhost:5432/researchmind

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ---------------- AI provider (the only paid piece) ----------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------- Free research APIs ----------------
# Semantic Scholar is used directly (not "if available") wherever paper
# search happens. Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key-here

# ---------------- Rate limiting on paid endpoints ----------------
CHAT_RATE_LIMIT_PER_MINUTE=10
AGENT_RATE_LIMIT_PER_MINUTE=5
