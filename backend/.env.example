# Copy this file to .env and fill in real values. Never commit .env itself.

ENV=development

# Local dev default (SQLite, zero setup):
DATABASE_URL=sqlite:///./researchmind.db
# Production (Postgres) example:
# DATABASE_URL=postgresql://researchmind_user:PASSWORD@localhost:5432/researchmind

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=7

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10

FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# ---------------- AI provider (the only paid piece) ----------------
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ---------------- Free research APIs ----------------
# Semantic Scholar is used directly (not "if available") wherever paper
# search happens. Get a free key at https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key-here

# ---------------- Rate limiting on paid endpoints ----------------
CHAT_RATE_LIMIT_PER_MINUTE=10
AGENT_RATE_LIMIT_PER_MINUTE=5

# ---------------- Frontend URL (used in verification/reset email links) ----------------
FRONTEND_URL=http://localhost:5173

# ---------------- Email (SMTP — free via your own Gmail/Outlook account) ----------------
# Leave blank to skip real sending — verification/reset emails just get
# logged to the console instead, so local dev still works with zero setup.
# For Gmail: enable 2FA on the Gmail account, then create an "app password"
# at https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# ---------------- Admin bootstrap ----------------
# Comma-separated usernames to auto-promote to admin on their next login.
ADMIN_USERNAMES=

# ---------------- Plan limits (free vs pro) ----------------
FREE_PLAN_MAX_DOCUMENTS=5
FREE_PLAN_CHAT_PER_DAY=30
FREE_PLAN_AGENT_PER_DAY=15
PRO_PLAN_MAX_DOCUMENTS=200
PRO_PLAN_CHAT_PER_DAY=1000
PRO_PLAN_AGENT_PER_DAY=500

# ---------------- Stripe (test mode is free — https://dashboard.stripe.com/test/apikeys) ----------------
STRIPE_SECRET_KEY=your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
STRIPE_PRICE_ID_PRO=your-stripe-price-id-for-the-pro-plan
